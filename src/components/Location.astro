---
import { Image } from "astro:assets";
import stadiumImage from "../images/allerswaldstadion.jpg";
---

<section id="location" class="location">
  <div class="container">
    <div class="location-grid">
      <!-- Left: Open editorial stadium details -->
      <div class="location-details">
        <p class="section-eyebrow">Heimspielstätte &middot; Seit 1959</p>
        <h2 class="section-title">Allerswaldstadion</h2>
        <p class="location-lead">
          Das Allerswaldstadion in Primstal ist seit 1959 das sportliche Zuhause des VfL Primstal.
        </p>

        <dl class="location-ledger">
          <div class="ledger-row">
            <dt class="ledger-label">Anschrift</dt>
            <dd class="ledger-value">Am Schwimmbad 10, 66620 Nonnweiler-Primstal</dd>
          </div>
        </dl>

        <div class="location-actions">
          <a
            href="https://www.google.com/maps/search/Allerswaldstadion+Primstal"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            In Google Maps öffnen &rarr;
          </a>
          <a href="/vfl-primstal/stadion" class="location-more-link">
            Mehr zum Stadion &rarr;
          </a>
        </div>
      </div>

      <!-- Right: Stadium photo -->
      <div class="stadium-photo-frame">
        <Image
          src={stadiumImage}
          alt="Luftaufnahme des Allerswaldstadions in Nonnweiler-Primstal"
          class="stadium-photo"
          width={960}
          height={540}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .location {
    background: var(--color-bg);
    padding: 6rem 0;
  }

  .location-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 4rem;
    align-items: center;
  }

  .location-details {
    display: flex;
    flex-direction: column;
  }

  .location-lead {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.65;
    margin: 0 0 2rem;
    max-width: 52ch;
    text-wrap: pretty;
  }

  .location-ledger {
    border-top: 1px solid var(--color-border);
    margin-bottom: 2.25rem;
  }

  .ledger-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--color-border);
    align-items: baseline;
  }

  .ledger-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-red);
  }

  .ledger-value {
    font-size: 0.96rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.45;
  }

  .location-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .location-more-link {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .location-more-link:hover {
    color: var(--color-red);
  }

  .stadium-photo-frame {
    aspect-ratio: 16 / 10;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .stadium-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 900px) {
    .location-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .ledger-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
