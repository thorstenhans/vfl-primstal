---
import { Image } from "astro:assets";
import stadiumImage from "../images/allerswaldstadion.jpg";
---

<section id="location" class="location">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Unser Stadion</h2>
      <p class="section-subtitle">Das Allerswaldstadion – unser Zuhause seit 1959.</p>
    </div>

    <div class="location-grid">
      <!-- Left: Info card -->
      <div class="info-card">
        <h3 class="stadium-name">Allerswaldstadion</h3>
        <div class="red-divider"></div>

        <div class="address-block">
          <div class="address-row">
            <span class="address-icon">📍</span>
            <span class="address-text">Am Schwimmbad 10</span>
          </div>
          <div class="address-row">
            <span class="address-icon">🏙️</span>
            <span class="address-text">66620 Nonnweiler-Primstal</span>
          </div>
          <div class="address-row">
            <span class="address-icon">🗺️</span>
            <span class="address-text">Saarland, Deutschland</span>
          </div>
        </div>

        <a
          href="https://www.google.com/maps/search/Allerswaldstadion+Primstal"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary map-btn"
        >
          In Google Maps öffnen &rarr;
        </a>
      </div>

      <!-- Right: Stadium photo -->
      <div class="stadium-photo-card">
        <Image
          src={stadiumImage}
          alt="Luftaufnahme des Allerswaldstadions in Nonnweiler-Primstal"
          class="stadium-photo"
          width={960}
          height={540}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .location {
    background: var(--color-bg);
    padding: 6rem 0;
  }

  .section-header {
    margin-bottom: 3.5rem;
  }

  .location-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: stretch;
  }

  @media (max-width: 768px) {
    .location-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Left - info card */
  .info-card {
    background: var(--color-surface);
    border-radius: 12px;
    padding: 2.5rem;
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
  }

  .stadium-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .red-divider {
    width: 40px;
    height: 2px;
    background: var(--color-red);
    margin-top: -0.75rem;
  }

  .address-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .address-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .address-icon {
    font-size: 1rem;
    color: var(--color-red);
    min-width: 1.25rem;
  }

  .address-text {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .map-btn {
    align-self: flex-start;
    display: inline-block;
    text-decoration: none;
  }

  /* Right - stadium photo */
  .stadium-photo-card {
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .stadium-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
