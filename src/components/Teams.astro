---
// Teams.astro
const teams = [
  {
    index: '01',
    name: '1. Mannschaft',
    href: '/vfl-primstal/teams/1-mannschaft',
    league: 'Verbandsliga Nord-Ost',
    description: 'Unsere erste Mannschaft spielt in der Verbandsliga Nord-Ost – der zweithöchsten Amateurklasse des Saarlandes.',
    fupaUrl: 'https://www.fupa.net/team/vfl-primstal-m1-2026-27',
  },
  {
    index: '02',
    name: '2. Mannschaft',
    href: '/vfl-primstal/teams/2-mannschaft',
    league: 'Landesliga Nord',
    description: 'Die zweite Mannschaft in der Landesliga Nord bietet eine starke Wettkampfplattform für talentierte Spieler.',
    fupaUrl: 'https://www.fupa.net/team/vfl-primstal-m2-2026-27',
  },
  {
    index: '03',
    name: 'Jugend',
    href: '/vfl-primstal/teams/jugend',
    league: 'VfL & JFG Schaumberg-Prims',
    description: 'Nachwuchsförderung von der G- bis zur E-Jugend beim VfL Primstal sowie ab der D-Jugend in der JFG Schaumberg-Prims.',
  },
  {
    index: '04',
    name: 'Alte Herren',
    href: '/vfl-primstal/teams/alte-herren',
    league: 'Freizeitfußball',
    description: 'Fußball kennt kein Alter! Die Alten Herren pflegen Leidenschaft und Kameradschaft auf und neben dem Platz.',
  },
];
---

<section id="teams" class="teams">
  <div class="container container--narrow">
    <div class="section-header section-header--center">
      <p class="section-eyebrow section-eyebrow--center">Spielbetrieb</p>
      <h2 class="section-title section-title--center">Unsere Mannschaften</h2>
      <p class="section-subtitle section-subtitle--center">Vom Nachwuchs bis zu den Aktiven – der VfL Primstal bietet für jeden das Richtige.</p>
    </div>

    <div class="teams-directory">
      {teams.map((team) => (
        <div class="team-row">
          <span class="team-index">{team.index}</span>
          <div class="team-identity">
            <h3 class="team-name">
              <a href={team.href} class="team-main-link">{team.name}</a>
            </h3>
            <span class="team-league">{team.league}</span>
          </div>
          <div class="team-actions">
            <span class="team-link team-link--primary" aria-hidden="true">
              Zur Mannschaft <span class="team-arrow">&rarr;</span>
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .teams {
    background: var(--color-bg);
    padding: 6.5rem 0;
  }

  .container--narrow {
    max-width: 860px;
  }

  .section-header--center {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .teams-directory {
    border-top: 2px solid var(--color-text);
  }

  .team-row {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    align-items: center;
    gap: 2rem;
    padding: 1.85rem 1.25rem 1.85rem 1rem;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.2s ease;
  }

  .team-row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-red);
    transform: scaleY(0);
    transition: transform 0.2s ease;
    transform-origin: center;
  }

  .team-row:hover {
    background-color: var(--color-surface);
  }

  .team-row:hover::before {
    transform: scaleY(1);
  }

  .team-index {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-red);
    font-variant-numeric: tabular-nums;
  }

  .team-identity {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .team-name {
    font-size: clamp(1.35rem, 2.2vw, 1.65rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0;
    line-height: 1.15;
    transition: color 0.2s ease;
  }

  .team-main-link {
    color: inherit;
    text-decoration: none;
  }

  .team-main-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .team-league {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-red);
    transition: color 0.2s ease;
  }

  .team-actions {
    display: flex;
    align-items: center;
    text-align: right;
  }

  .team-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-red);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .team-arrow {
    display: inline-block;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  /* Hover states requested by user: link and tagline turn to white */
  .team-row:hover .team-name {
    color: #ffffff;
  }

  .team-row:hover .team-league {
    color: #ffffff;
  }

  .team-row:hover .team-link {
    color: #ffffff;
  }

  .team-row:hover .team-arrow {
    transform: translateX(4px);
    color: #ffffff;
  }

  :global([data-theme="light"]) .team-row:hover .team-name,
  :global([data-theme="light"]) .team-row:hover .team-league,
  :global([data-theme="light"]) .team-row:hover .team-link,
  :global([data-theme="light"]) .team-row:hover .team-arrow {
    color: #000000;
  }

  @media (max-width: 720px) {
    .team-row {
      grid-template-columns: 2.5rem 1fr;
      gap: 1rem;
      padding: 1.75rem 0.5rem;
    }

    .team-actions {
      grid-column: 2;
      align-items: flex-start;
      text-align: left;
      margin-top: 0.25rem;
      min-width: 0;
    }
  }
</style>
