---
import { Image, getImage } from 'astro:assets';
import 'photoswipe/style.css';
import aktiveImage from '../images/aktive-2026-2027.jpg';

const fullImage = await getImage({
  src: aktiveImage,
  format: 'webp',
  quality: 90,
});

const caption = 'Kader Aktive – 1. & 2. Mannschaft';
const season = 'Saison 2026/2027';
---

<div class="team-photo-gallery" id="team-lightbox-gallery">
  <a
    href={fullImage.src}
    class="feed-item"
    data-pswp-width={aktiveImage.width}
    data-pswp-height={aktiveImage.height}
    data-caption={caption}
    data-date={season}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${caption} (${season}) vergrößern`}
  >
    <div class="feed-img-wrap">
      <Image
        src={aktiveImage}
        alt={`${caption} – ${season}`}
        class="feed-img"
        width={900}
        height={Math.round((900 * aktiveImage.height) / aktiveImage.width)}
      />
      <div class="feed-overlay">
        <p class="feed-caption">{caption}</p>
        <span class="feed-date">{season}</span>
      </div>
    </div>
  </a>
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '#team-lightbox-gallery',
    children: 'a.feed-item',
    pswpModule: () => import('photoswipe'),
    bgOpacity: 0.92,
  });

  lightbox.on('uiRegister', () => {
    lightbox.pswp?.ui?.registerElement({
      name: 'custom-caption',
      order: 9,
      isButton: false,
      appendTo: 'root',
      onInit: (el) => {
        lightbox.pswp?.on('change', () => {
          const currSlideElement = lightbox.pswp?.currSlide?.data.element as HTMLElement | undefined;
          const caption = currSlideElement?.dataset.caption || '';
          const date = currSlideElement?.dataset.date || '';
          if (caption || date) {
            el.innerHTML = `
              <div class="pswp-ig-caption">
                ${caption ? `<p class="pswp-ig-caption__text">${caption}</p>` : ''}
                ${date ? `<span class="pswp-ig-caption__date">${date}</span>` : ''}
              </div>
            `;
            el.style.display = 'block';
          } else {
            el.innerHTML = '';
            el.style.display = 'none';
          }
        });
      },
    });
  });

  lightbox.init();
</script>

<style>
  .team-photo-gallery {
    max-width: 780px;
    margin: 0 auto 3.5rem;
  }

  .feed-item {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    cursor: zoom-in;
  }

  .feed-img-wrap {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .feed-img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.35s ease;
  }

  .feed-item:hover .feed-img {
    transform: scale(1.05);
  }

  .feed-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, transparent 55%);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1rem 1.25rem;
  }

  .feed-item:hover .feed-overlay {
    opacity: 1;
  }

  .feed-caption {
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 0.2rem;
  }

  .feed-date {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.78rem;
    font-weight: 500;
  }

  :global(.pswp-ig-caption) {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    max-width: 560px;
    width: calc(100% - 2rem);
    background: rgba(18, 18, 18, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    color: #fff;
    text-align: center;
    pointer-events: none;
    z-index: 20;
  }

  :global(.pswp-ig-caption__text) {
    font-size: 0.9rem;
    line-height: 1.45;
    margin: 0 0 0.25rem;
    white-space: pre-line;
  }

  :global(.pswp-ig-caption__date) {
    display: block;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.65);
  }
</style>
