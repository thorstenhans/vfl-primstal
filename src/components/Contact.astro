---
// Contact.astro
---

<section id="contact" class="contact">
  <div class="container container--narrow">
    <div class="contact-header">
      <p class="section-eyebrow section-eyebrow--center">Kontakt</p>
      <h2 class="section-title section-title--center">Kontakt &amp; Ansprechpartner</h2>
      <p class="section-subtitle section-subtitle--center">
        Fragen, Anregungen oder Interesse am Verein? Wir freuen uns, von euch zu hören.
      </p>
    </div>

    <div class="contact-channels">
      <div class="channel-card">
        <span class="channel-label">Allgemeine Anfragen</span>
        <a href="mailto:info@vfl-primstal.de" class="channel-email">
          info@vfl-primstal.de
        </a>
        <p class="channel-sub">Schreib uns einfach eine Nachricht per E-Mail.</p>
      </div>

      <div class="channel-card">
        <span class="channel-label">Vereinsführung</span>
        <a href="/vfl-primstal/vorstand" class="channel-action-link">
          Zum Vorstand &rarr;
        </a>
        <p class="channel-sub">
          Alle Ansprechpartner für Spielbetrieb, Jugend und Organisation.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-bg-alt);
    padding: 6.5rem 0 7rem;
    border-top: 1px solid var(--color-border);
  }

  .container--narrow {
    max-width: 820px;
  }

  .contact-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .contact-channels {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    border-top: 2px solid var(--color-text);
    padding-top: 2.5rem;
  }

  .channel-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    padding: 1.5rem 1rem;
  }

  .channel-label {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-red);
  }

  .channel-email {
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .channel-email:hover {
    color: var(--color-red);
  }

  .channel-action-link {
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .channel-action-link:hover {
    color: var(--color-red);
  }

  .channel-sub {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    max-width: 38ch;
  }

  @media (max-width: 640px) {
    .contact {
      padding: 4.5rem 0 5rem;
    }

    .contact-channels {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-top: 1.75rem;
    }

    .channel-card {
      padding: 1rem 0;
      border-bottom: 1px solid var(--color-border);
    }

    .channel-card:last-child {
      border-bottom: none;
    }
  }
</style>
