---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import StandingsTable from "../../components/StandingsTable.astro";
import TeamPhoto from "../../components/TeamPhoto.astro";
import { siteConfig } from "../../config/site";
import standingsM2 from "../../data/standings-m2.json";

const team = siteConfig.teams[1];
---

<Layout
    title={`${team.name} – VfL Primstal`}
    description={team.description}
>
    <Header />

    <main class="team-page-main">
        <section class="page-hero">
            <div class="container">
                <p class="hero-eyebrow">Aktive &middot; Herren</p>
                <h1 class="hero-title">{team.name}</h1>
                <p class="hero-subtitle">{team.description}</p>
            </div>
        </section>

        <section class="team-section">
            <div class="container">
                <!-- Aktuelle Liga & FuPa Architectural Meta Bar -->
                <div class="league-meta-bar">
                    <div class="league-info">
                        <span class="league-label">Aktuelle Liga</span>
                        <h2 class="league-name">{team.league}</h2>
                    </div>
                    {team.fupaUrl && (
                        <a
                            href={team.fupaUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-outline fupa-btn"
                        >
                            Auf FuPa ansehen &nearr;
                        </a>
                    )}
                </div>

                <!-- Mannschaftsfoto -->
                <TeamPhoto />

                <!-- Aktuelle Tabelle -->
                <div class="standings-section">
                    <div class="section-header">
                        <p class="section-eyebrow">Saison 2026/2027</p>
                        <h2 class="subsection-title">Aktuelle Tabelle</h2>
                        <p class="subsection-subtitle">
                            Tabellenstand in der {team.league}.
                        </p>
                    </div>
                    <StandingsTable standings={standingsM2} />
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    .team-page-main {
        padding-top: var(--header-height);
        min-height: 100vh;
    }

    .page-hero {
        background: var(--color-bg);
        padding: 5rem 0 4rem;
        border-bottom: 1px solid var(--color-border);
        position: relative;
        overflow: hidden;
    }

    .page-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at 30% 60%,
            rgba(200, 16, 46, 0.07) 0%,
            transparent 65%
        );
        pointer-events: none;
    }

    .page-hero .container {
        position: relative;
    }

    .hero-title {
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        font-weight: 800;
        color: var(--color-text);
        line-height: 1.1;
        letter-spacing: -0.025em;
        margin-bottom: 1rem;
        text-wrap: balance;
    }

    .hero-subtitle {
        color: var(--color-text-muted);
        font-size: 1.05rem;
        max-width: 62ch;
        line-height: 1.7;
        text-wrap: pretty;
    }

    .team-section {
        background: var(--color-bg-alt);
        padding: 3.5rem 0 6rem;
    }

    .league-meta-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1.5rem;
        padding-bottom: 2rem;
        margin-bottom: 3rem;
        border-bottom: 1px solid var(--color-border);
    }

    .league-label {
        display: block;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-red);
        margin-bottom: 0.25rem;
    }

    .league-name {
        font-size: clamp(1.35rem, 3vw, 1.85rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--color-text);
        margin: 0;
    }

    .section-header {
        margin-bottom: 1.75rem;
    }
</style>
