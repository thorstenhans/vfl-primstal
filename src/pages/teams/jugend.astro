---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
    title="Jugendfußball – VfL Primstal"
    description="Nachwuchsförderung beim VfL Primstal: G- bis E-Jugend im Verein sowie D- bis A-Jugend in der JFG Schaumberg-Prims."
>
    <Header />

    <main class="team-page-main">
        <section class="page-hero">
            <div class="container">
                <p class="hero-eyebrow">Nachwuchsförderung</p>
                <h1 class="hero-title">Unsere Jugend</h1>
                <p class="hero-subtitle">
                    Die Zukunft unseres Vereins beginnt beim Nachwuchs. Mit Begeisterung,
                    Teamgeist und qualifizierter Betreuung begleiten wir Kinder und Jugendliche
                    von den ersten Schritten am Ball bis in den Aktivenbereich.
                </p>
            </div>
        </section>

        <section class="team-section">
            <div class="container">
                <!-- Open Editorial Lead & Pathway -->
                <div class="concept-editorial">
                    <div class="concept-heading">
                        <p class="section-eyebrow">Durchgängiges Konzept</p>
                        <h2 class="subsection-title">Gemeinsam stark – von den Bambinis bis zur A-Jugend</h2>
                    </div>
                    <p class="concept-text">
                        Beim VfL Primstal steht die altersgerechte Förderung im Mittelpunkt:
                        Die jüngeren Jahrgänge von der <strong>G- bis zur E-Jugend</strong> werden direkt
                        vom <strong>VfL Primstal</strong> betreut, wo Freude an der Bewegung, Fairplay und
                        die fußballerischen Grundlagen im Vordergrund stehen. Ab der <strong>D-Jugend</strong>
                        wird das Geschehen durch die <strong>JFG Schaumberg-Prims</strong> bestimmt, um unseren
                        Jugendlichen bis zur A-Jugend optimale sportliche Perspektiven in starken Mannschaften
                        zu bieten.
                    </p>
                </div>

                <!-- Age-Group Progression Bar (U7 -> U19) -->
                <div class="pathway-bar" aria-label="Altersklassen-Entwicklung von U7 bis U19">
                    <div class="pathway-group pathway-group--vfl">
                        <span class="pathway-org">VfL Primstal &middot; Grundlagenbereich</span>
                        <div class="pathway-steps">
                            <span>G-Jugend (U7)</span>
                            <span class="step-sep">&rarr;</span>
                            <span>F-Jugend (U9)</span>
                            <span class="step-sep">&rarr;</span>
                            <span>E-Jugend (U10/U11)</span>
                        </div>
                    </div>
                    <div class="pathway-group pathway-group--jfg">
                        <span class="pathway-org">JFG Schaumberg-Prims &middot; Aufbaubereich</span>
                        <div class="pathway-steps">
                            <span>D-Jugend (U13)</span>
                            <span class="step-sep">&rarr;</span>
                            <span>C-Jugend (U15)</span>
                            <span class="step-sep">&rarr;</span>
                            <span>B-Jugend (U17)</span>
                            <span class="step-sep">&rarr;</span>
                            <span>A-Jugend (U19)</span>
                        </div>
                    </div>
                </div>

                <!-- Auswahl der zwei Bereiche -->
                <div class="section-header">
                    <p class="section-eyebrow">Mannschaften &amp; Kontakt</p>
                    <h2 class="subsection-title">Unsere Jugendbereiche</h2>
                    <p class="subsection-subtitle">
                        Wähle einen Bereich, um mehr über die einzelnen Altersklassen, Trainingszeiten und Ansprechpartner zu erfahren.
                    </p>
                </div>

                <div class="youth-branches-grid">
                    <!-- VfL Primstal (G- bis E-Jugend) -->
                    <article class="branch-portal branch-portal--vfl">
                        <span class="branch-kicker">01 &middot; G- bis E-Jugend (U7 – U11)</span>
                        <h3 class="branch-title">
                            <a href="/vfl-primstal/teams/jugend/vfl-primstal" class="branch-main-link">
                                Jugend VfL Primstal
                            </a>
                        </h3>
                        <p class="branch-desc">
                            Unsere jüngsten Kickerinnen und Kicker starten direkt unter dem Dach des VfL Primstal.
                            Von der G-Jugend (Bambini) über die F-Jugend bis zur E-Jugend vermitteln wir
                            spielerisch Technik, Teamgeist und den Spaß am Vereinsleben.
                        </p>
                        <p class="team-inline-list" aria-label="Mannschaften beim VfL Primstal">
                            G-Jugend (U7) &middot; F-Jugend (U9) &middot; E-Jugend (U10/U11)
                        </p>
                        <div class="branch-footer">
                            <span class="branch-cta" aria-hidden="true">
                                Zu den Mannschaften (G–E) <span class="branch-arrow">&rarr;</span>
                            </span>
                        </div>
                    </article>

                    <!-- JFG Schaumberg-Prims (D- bis A-Jugend) -->
                    <article class="branch-portal branch-portal--jfg">
                        <span class="branch-kicker">02 &middot; D- bis A-Jugend (U13 – U19)</span>
                        <h3 class="branch-title">
                            <a href="/vfl-primstal/teams/jugend/jfg-schaumberg-prims" class="branch-main-link">
                                JFG Schaumberg-Prims
                            </a>
                        </h3>
                        <p class="branch-desc">
                            Ab der D-Jugend wird der Spiel- und Trainingsbetrieb durch die Jugendfördergemeinschaft
                            <strong>JFG Schaumberg-Prims</strong> bestimmt. Hier wachsen die Talente der Stammvereine
                            zusammen und bereiten sich gezielt auf den Übergang in den Seniorenfußball vor.
                        </p>
                        <p class="team-inline-list" aria-label="Mannschaften der JFG Schaumberg-Prims">
                            D-Jugend (U13) &middot; C-Jugend (U15) &middot; B-Jugend (U17) &middot; A-Jugend (U19)
                        </p>
                        <div class="branch-footer">
                            <span class="branch-cta" aria-hidden="true">
                                Zu den Mannschaften (D–A) <span class="branch-arrow">&rarr;</span>
                            </span>
                        </div>
                    </article>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    .team-page-main {
        padding-top: var(--header-height);
        min-height: 100vh;
    }

    .page-hero {
        background: var(--color-bg);
        padding: 5rem 0 4rem;
        border-bottom: 1px solid var(--color-border);
        position: relative;
        overflow: hidden;
    }

    .page-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at 30% 60%,
            rgba(200, 16, 46, 0.07) 0%,
            transparent 65%
        );
        pointer-events: none;
    }

    .page-hero .container {
        position: relative;
    }

    .hero-title {
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        font-weight: 800;
        color: var(--color-text);
        line-height: 1.1;
        letter-spacing: -0.025em;
        margin-bottom: 1rem;
        text-wrap: balance;
    }

    .hero-subtitle {
        color: var(--color-text-muted);
        font-size: 1.05rem;
        max-width: 65ch;
        line-height: 1.7;
        text-wrap: pretty;
    }

    .team-section {
        background: var(--color-bg-alt);
        padding: 5rem 0 7rem;
    }

    /* Concept Editorial Split */
    .concept-editorial {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 4rem;
        align-items: start;
        margin-bottom: 3.5rem;
    }

    .concept-text {
        color: var(--color-text-muted);
        font-size: 1.02rem;
        line-height: 1.8;
        max-width: 65ch;
        margin: 0;
        text-wrap: pretty;
    }

    .concept-text strong {
        color: var(--color-text);
        font-weight: 700;
    }

    /* Age-Group Progression Bar */
    .pathway-bar {
        display: grid;
        grid-template-columns: 1fr 1.25fr;
        border-top: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
        margin-bottom: 5.5rem;
    }

    .pathway-group {
        padding: 1.75rem 2rem 1.75rem 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .pathway-group--vfl {
        border-right: 1px solid var(--color-border);
    }

    .pathway-group--jfg {
        padding-left: 2rem;
        padding-right: 0;
    }

    .pathway-org {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-red);
    }

    .pathway-steps {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.65rem;
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-text);
        font-variant-numeric: tabular-nums;
    }

    .step-sep {
        color: var(--color-text-muted);
        font-weight: 400;
    }

    /* Section Header */
    .section-header {
        margin-bottom: 2.75rem;
    }

    /* Two-Branch Architectural Portal Split */
    .youth-branches-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2.5rem;
    }

    .branch-portal {
        position: relative;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-top: 2px solid var(--color-red);
        border-radius: 4px;
        padding: 2.75rem 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            transform 0.2s ease;
    }

    .branch-portal--jfg {
        border-top-color: var(--color-text);
    }

    .branch-portal:hover {
        transform: translateY(-2px);
        border-color: var(--color-red);
        box-shadow: var(--shadow-card-hover);
    }

    .branch-kicker {
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-red);
        font-variant-numeric: tabular-nums;
    }

    .branch-title {
        font-size: clamp(1.4rem, 2.5vw, 1.75rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--color-text);
        margin: 0;
        text-wrap: wrap;
    }

    .branch-main-link {
        color: inherit;
        text-decoration: none;
    }

    .branch-main-link::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: 4px;
    }

    .branch-desc {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        line-height: 1.7;
        margin: 0;
        flex: 1;
        text-wrap: pretty;
    }

    .branch-desc strong {
        color: var(--color-text);
    }

    .team-inline-list {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--color-text);
        font-variant-numeric: tabular-nums;
        padding-top: 0.5rem;
        margin: 0;
    }

    .branch-footer {
        margin-top: 0.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--color-border);
    }

    .branch-cta {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--color-red);
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .branch-arrow {
        display: inline-block;
        transition: transform 0.2s ease;
    }

    .branch-portal:hover .branch-arrow {
        transform: translateX(4px);
    }

    @media (max-width: 860px) {
        .concept-editorial,
        .pathway-bar,
        .youth-branches-grid {
            grid-template-columns: 1fr;
        }

        .pathway-group--vfl {
            border-right: none;
            border-bottom: 1px solid var(--color-border);
            padding-right: 0;
        }

        .pathway-group--jfg {
            padding-left: 0;
        }
    }
</style>
