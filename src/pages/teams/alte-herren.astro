---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { siteConfig } from "../../config/site";

const team = siteConfig.teams.find((t) => t.slug === "alte-herren")!;
---

<Layout
    title={`${team.name} (AH) – VfL Primstal`}
    description="Alte Herren (AH) des VfL Primstal – Training jeden Donnerstag um 20:00 Uhr. Jeder ist herzlich willkommen, mitzukicken!"
>
    <Header />

    <main class="team-page-main">
        <section class="page-hero">
            <div class="container">
                <p class="hero-eyebrow">{team.league}</p>
                <h1 class="hero-title">{team.name} (AH)</h1>
                <p class="hero-subtitle">{team.description}</p>
            </div>
        </section>

        <section class="team-section">
            <div class="container">
                <!-- Open Editorial Lead Section -->
                <div class="welcome-editorial">
                    <div class="welcome-heading-col">
                        <p class="section-eyebrow">Lust auf Fußball?</p>
                        <h2 class="subsection-title">Jeder ist herzlich willkommen!</h2>
                    </div>
                    <p class="welcome-text">
                        Egal ob ehemaliger Vereinsspieler, Wiedereinsteiger oder einfach aus Freude am Fußball –
                        bei unserer AH stehen der gemeinsame Spaß am Kicken und die Kameradschaft im Vordergrund.
                        Komm einfach donnerstags vorbei und kick mit!
                    </p>
                </div>

                <!-- Trainingszeiten & Orte Architectural Schedule Split -->
                <div class="training-section">
                    <div class="section-header">
                        <p class="section-eyebrow">Wöchentlicher Trainingsbetrieb</p>
                        <h2 class="subsection-title">Trainingszeiten &amp; Orte</h2>
                        <p class="subsection-subtitle">
                            Wir trainieren ganzjährig jeden Donnerstagabend um 20:00 Uhr.
                        </p>
                    </div>

                    <div class="schedule-split">
                        <!-- Freilufttraining -->
                        <div class="schedule-col schedule-col--primary">
                            <span class="season-kicker">01 &middot; Frühjahr – Herbst</span>
                            <h3 class="schedule-title">Freilufttraining</h3>
                            <dl class="schedule-ledger">
                                <div class="schedule-row">
                                    <dt class="schedule-label">Zeit</dt>
                                    <dd class="schedule-value">
                                        <strong>Donnerstags, 20:00 Uhr</strong>
                                        <span>Wöchentlicher Trainingsabend</span>
                                    </dd>
                                </div>
                                <div class="schedule-row">
                                    <dt class="schedule-label">Ort</dt>
                                    <dd class="schedule-value">
                                        <strong>Allerswaldstadion Primstal</strong>
                                        <span>Am Schwimmbad 10, 66620 Nonnweiler-Primstal</span>
                                    </dd>
                                </div>
                            </dl>
                        </div>

                        <!-- Wintertraining -->
                        <div class="schedule-col">
                            <span class="season-kicker season-kicker--winter">02 &middot; Wintermonate</span>
                            <h3 class="schedule-title">Hallentraining im Winter</h3>
                            <dl class="schedule-ledger">
                                <div class="schedule-row">
                                    <dt class="schedule-label">Zeit</dt>
                                    <dd class="schedule-value">
                                        <strong>Donnerstags, 20:00 Uhr</strong>
                                        <span>Zur gleichen Zeit wie im Sommer</span>
                                    </dd>
                                </div>
                                <div class="schedule-row">
                                    <dt class="schedule-label">Ort</dt>
                                    <dd class="schedule-value">
                                        <strong>Mehrzweckhalle Primstal</strong>
                                        <span>66620 Nonnweiler-Primstal</span>
                                    </dd>
                                </div>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    .team-page-main {
        padding-top: var(--header-height);
        min-height: 100vh;
    }

    .page-hero {
        background: var(--color-bg);
        padding: 5rem 0 4rem;
        border-bottom: 1px solid var(--color-border);
        position: relative;
        overflow: hidden;
    }

    .page-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at 30% 60%,
            rgba(200, 16, 46, 0.07) 0%,
            transparent 65%
        );
        pointer-events: none;
    }

    .page-hero .container {
        position: relative;
    }

    .hero-title {
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        font-weight: 800;
        color: var(--color-text);
        line-height: 1.1;
        letter-spacing: -0.025em;
        margin-bottom: 1rem;
        text-wrap: balance;
    }

    .hero-subtitle {
        color: var(--color-text-muted);
        font-size: 1.05rem;
        max-width: 60ch;
        line-height: 1.7;
        text-wrap: pretty;
    }

    .team-section {
        background: var(--color-bg-alt);
        padding: 4.5rem 0 6.5rem;
    }

    /* Open Editorial Lead Section */
    .welcome-editorial {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 3.5rem;
        align-items: start;
        padding-bottom: 4rem;
        margin-bottom: 4.5rem;
        border-bottom: 1px solid var(--color-border);
    }

    .welcome-text {
        color: var(--color-text-muted);
        font-size: 1.05rem;
        line-height: 1.75;
        max-width: 62ch;
        margin: 0;
        text-wrap: pretty;
    }

    /* Section Header */
    .section-header {
        margin-bottom: 2.5rem;
    }

    /* Schedule Split */
    .schedule-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
    }

    .schedule-col {
        border-top: 2px solid var(--color-border);
        padding-top: 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .schedule-col--primary {
        border-top-color: var(--color-red);
    }

    .season-kicker {
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-red);
        font-variant-numeric: tabular-nums;
    }

    .season-kicker--winter {
        color: var(--color-text-muted);
    }

    .schedule-title {
        font-size: 1.4rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--color-text);
        margin: 0 0 0.75rem;
    }

    .schedule-ledger {
        border-top: 1px solid var(--color-border);
    }

    .schedule-row {
        display: grid;
        grid-template-columns: 80px 1fr;
        gap: 1rem;
        padding: 1.1rem 0;
        border-bottom: 1px solid var(--color-border);
        align-items: baseline;
    }

    .schedule-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-red);
    }

    .schedule-value {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .schedule-value strong {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--color-text);
        font-variant-numeric: tabular-nums;
    }

    .schedule-value span {
        font-size: 0.88rem;
        color: var(--color-text-muted);
    }

    @media (max-width: 820px) {
        .welcome-editorial,
        .schedule-split {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }
</style>
