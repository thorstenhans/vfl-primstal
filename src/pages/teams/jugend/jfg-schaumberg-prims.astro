---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";

const jfgTeams = [
    {
        id: "d-jugend",
        name: "D-Jugend",
        ageGroup: "U13 · 11 bis 12 Jahre",
        subtitle: "Der Einstieg in die JFG Schaumberg-Prims.",
        description:
            "Mit der D-Jugend wechseln unsere Nachwuchskicker in die Jugendfördergemeinschaft JFG Schaumberg-Prims. Im sogenannten goldenen Lernalter werden hier Technik, Koordination und das Zusammenspiel auf dem größeren Feld gemeinsam mit den Partnervereinen intensiv gefördert.",
    },
    {
        id: "c-jugend",
        name: "C-Jugend",
        ageGroup: "U15 · 13 bis 14 Jahre",
        subtitle: "Übergang auf das Großfeld (11 gegen 11).",
        description:
            "In der C-Jugend steht die Gewöhnung an das große Spielfeld im Mittelpunkt. Taktische Abläufe, Athletik und das mannschaftliche Zusammenspiel über die Stammvereine hinweg werden gezielt weiterentwickelt.",
    },
    {
        id: "b-jugend",
        name: "B-Jugend",
        ageGroup: "U17 · 15 bis 16 Jahre",
        subtitle: "Dynamischer Jugendfußball und taktische Reife.",
        description:
            "In der B-Jugend steht die Weiterentwicklung von Spielintelligenz, Tempo und mannschaftstaktischem Verhalten im Fokus. Unsere Teams messen sich im saarländischen Spielbetrieb und fördern jedes Talent entsprechend seinen Stärken.",
    },
    {
        id: "a-jugend",
        name: "A-Jugend",
        ageGroup: "U19 · 17 bis 18 Jahre",
        subtitle: "Das Sprungbrett in den Aktivenbereich.",
        description:
            "Die A-Jugend bildet die höchste Altersklasse im Juniorenfußball. Hier bereiten wir unsere Nachwuchsspieler intensiv auf den nahtlosen Übergang in die 1. und 2. Mannschaft des VfL Primstal sowie der Partnervereine vor.",
    },
];
---

<Layout
    title="JFG Schaumberg-Prims (D- bis A-Jugend) – VfL Primstal"
    description="Die Jugendmannschaften der JFG Schaumberg-Prims von der D-Jugend (U13) bis zur A-Jugend (U19)."
>
    <Header />

    <main class="team-page-main">
        <section class="page-hero">
            <div class="container">
                <a href="/vfl-primstal/teams/jugend" class="back-link">
                    &larr; Zurück zur Jugend-Übersicht
                </a>
                <p class="hero-eyebrow">D- bis A-Jugend (U13 – U19)</p>
                <h1 class="hero-title">JFG Schaumberg-Prims</h1>
                <p class="hero-subtitle">
                    Ab der D-Jugend gestalten wir unsere Nachwuchsarbeit gemeinsam in der
                    Jugendfördergemeinschaft <strong>JFG Schaumberg-Prims</strong> – für starke
                    Mannschaften, optimale Förderung und einen erfolgreichen Weg in den Aktivenbereich.
                </p>

                <nav class="quick-nav" aria-label="Schnellnavigation Altersklassen">
                    {jfgTeams.map((t) => (
                        <a href={`#${t.id}`} class="quick-nav-link">
                            <span class="quick-nav-arrow" aria-hidden="true">&darr;</span> {t.name}
                        </a>
                    ))}
                </nav>
            </div>
        </section>

        <section class="team-section">
            <div class="container">
                <div class="age-ledger">
                    {jfgTeams.map((t) => (
                        <section id={t.id} class="age-ledger-row">
                            <div class="age-rail">
                                <span class="age-kicker">{t.ageGroup}</span>
                                <h2 class="age-title">{t.name}</h2>
                                <p class="age-subtitle">{t.subtitle}</p>
                            </div>
                            <div class="age-body">
                                <p class="age-description">{t.description}</p>
                            </div>
                        </section>
                    ))}
                </div>

                <div class="switch-callout">
                    <div>
                        <span class="switch-label">Jüngere Jahrgänge (U7 – U11)</span>
                        <h3 class="switch-title">G- bis E-Jugend beim VfL Primstal</h3>
                        <p class="switch-text">
                            Die Altersklassen von den Bambinis (G-Jugend) über die F-Jugend bis zur E-Jugend
                            werden direkt vom VfL Primstal betreut.
                        </p>
                    </div>
                    <a href="/vfl-primstal/teams/jugend/vfl-primstal" class="btn-outline">
                        Zur VfL-Jugend (G–E) &rarr;
                    </a>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    .team-page-main {
        padding-top: var(--header-height);
        min-height: 100vh;
    }

    .page-hero {
        background: var(--color-bg);
        padding: 4rem 0 2.5rem;
        border-bottom: 1px solid var(--color-border);
        position: relative;
        overflow: hidden;
    }

    .page-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at 30% 60%,
            rgba(200, 16, 46, 0.07) 0%,
            transparent 65%
        );
        pointer-events: none;
    }

    .page-hero .container {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .back-link {
        display: inline-block;
        color: var(--color-text-muted);
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        margin-bottom: 1.25rem;
        transition: color 0.2s ease;
    }

    .back-link:hover {
        color: var(--color-red);
    }

    .hero-title {
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        font-weight: 800;
        color: var(--color-text);
        line-height: 1.1;
        letter-spacing: -0.025em;
        margin-bottom: 1rem;
        text-wrap: balance;
    }

    .hero-subtitle {
        color: var(--color-text-muted);
        font-size: 1.05rem;
        max-width: 65ch;
        line-height: 1.7;
        margin-bottom: 2.25rem;
        text-wrap: pretty;
    }

    .hero-subtitle strong {
        color: var(--color-text);
    }

    .quick-nav {
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--color-border);
    }

    .quick-nav-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--color-text);
        font-size: 0.88rem;
        font-weight: 700;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .quick-nav-arrow {
        color: var(--color-red);
    }

    .quick-nav-link:hover {
        color: var(--color-red);
    }

    .team-section {
        background: var(--color-bg-alt);
        padding: 2rem 0 6rem;
    }

    .age-ledger {
        display: flex;
        flex-direction: column;
        margin-bottom: 3.5rem;
    }

    .age-ledger-row {
        scroll-margin-top: calc(var(--header-height) + 1.5rem);
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 3.5rem;
        padding: 3.5rem 0;
        border-bottom: 1px solid var(--color-border);
        align-items: start;
    }

    .age-rail {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }

    .age-kicker {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-red);
        font-variant-numeric: tabular-nums;
    }

    .age-title {
        font-size: clamp(1.5rem, 2.5vw, 1.85rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--color-text);
        margin: 0;
        line-height: 1.2;
    }

    .age-subtitle {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--color-text);
        margin: 0.25rem 0 0;
        line-height: 1.5;
    }

    .age-description {
        color: var(--color-text-muted);
        font-size: 1.02rem;
        line-height: 1.8;
        margin: 0;
        max-width: 65ch;
        text-wrap: pretty;
    }

    .switch-callout {
        border-top: 2px solid var(--color-text);
        padding-top: 3.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 2rem;
    }

    .switch-label {
        display: block;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-red);
        margin-bottom: 0.3rem;
    }

    .switch-title {
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--color-text);
        margin: 0 0 0.35rem;
    }

    .switch-text {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        margin: 0;
        max-width: 58ch;
        line-height: 1.65;
        text-wrap: pretty;
    }

    @media (max-width: 820px) {
        .age-ledger-row {
            grid-template-columns: 1fr;
            gap: 1rem;
            padding: 2.25rem 0;
        }
    }
</style>
