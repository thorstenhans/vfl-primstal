---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";

const youthTeams = [
    {
        id: "g-jugend",
        name: "Unsere G-Jugend / U7",
        ageGroup: "Mädchen & Jungen ab 4 Jahren",
        teamsText:
            "In der G-Jugend spielen Mädchen und Jungen ab 4 Jahren – einfach mal beim Training vorbeischauen und reinschnuppern!",
        matchInfoTitle: "Spieltage in Turnierform",
        matchInfo:
            "Spiele in Turnierform an wechselnden Spielorten (Nordsaar). Gespielt wird mit 3 Feldspielern (ohne Torwart) auf einem altersgerechten Kleinspielfeld mit 4 Minitoren. In den Wintermonaten werden Hallenturniere mit demselben Spielprinzip ausgetragen.",
        training:
            "Mittwochs ab 16:30 Uhr und freitags ab 16:00 Uhr, jeweils für 1 Stunde im Allerswaldstadion Primstal. Wir freuen uns auf weitere Zugänge – einfach mal beim Training vorbeikommen und reinschnuppern! In den Wintermonaten wird das Training in die Halle verlegt (hier kann es bedingt durch die Hallenbelegung zu abweichenden Trainingszeiten kommen).",
        coaches: "Thorsten Gierend, Daniel Bohnen, Arne Stratmann",
        contact: {
            name: "Thorsten Gierend",
            whatsapp: "0178 / 396 82 09",
            email: "thorsten_gierend@web.de",
        },
    },
    {
        id: "f-jugend",
        name: "Unsere F-Jugend / U9",
        ageGroup: "Jahrgänge 2018 / 2019 (Saison 26/27)",
        teamsText:
            "In der Saison 26/27 kicken die Jahrgänge 2018/2019 in der F-Jugend. Die Mannschaften bestehen aus vier Feldspielern plus Torwart. Gespielt wird auf einem altersgerechten Kleinfeld mit 3×2 m Jugendtoren.",
        matchInfoTitle: "Spielort",
        matchInfo:
            "Gespielt wird in Turnierform an wechselnden Spielorten im Kreis Nordsaar.",
        training:
            "Mittwoch und Freitag von 16:30 bis 18:00 Uhr im Allerswaldstadion Primstal. Wir freuen uns auf weitere Zugänge – einfach mal beim Training vorbeikommen und reinschnuppern! In den Wintermonaten wird das Training in die Halle verlegt (hier kann es bedingt durch die Hallenbelegung zu abweichenden Trainingszeiten kommen).",
        coaches: "Sven Seimetz, Mike Scharf, Tobias Wiesen",
        contact: {
            name: "Sven Seimetz",
            whatsapp: "0151 / 51931139",
            email: "sven.seimetz@gmx.de",
        },
    },
    {
        id: "e-jugend",
        name: "Unsere E-Jugend / U10 + U11",
        ageGroup: "9 bis 10 Jahre (U10 & U11)",
        teamsText:
            "Die E-Jugend ist die drittjüngste Altersklasse im Jugendfußball. Kinder in dieser Altersklasse sind in der Regel 9 bis 10 Jahre alt, wobei die U10 den jüngeren Jahrgang und die U11 den älteren Jahrgang bildet. Je nach der Anzahl der Kinder und der internen Teamstruktur kann auch in gemischten Teams gespielt werden.",
        matchInfoTitle: "Spielort",
        matchInfo:
            "Primstal Allerswaldstadion – die Heimspiele der U11 finden in der Regel jeden zweiten Samstagnachmittag um 14:00 Uhr statt, im Wechsel finden die Auswärtsspiele statt. Pflichtfreundschaftsspieltage der U10 finden jeden Samstag statt und werden kurzfristig angesetzt. In den Wintermonaten werden Hallenturniere ausgetragen.",
        training:
            "Trainingstage sind in der Regel Dienstag und Donnerstag, jeweils von 17:00 Uhr bis 18:30 Uhr in Primstal im Allerswaldstadion. In den Wintermonaten wird das Training in die Halle verlegt (hier kann es bedingt durch die Hallenbelegung zu abweichenden Trainingszeiten kommen).",
        coaches: "Daniel Arm, Sascha Nachtwey, Jannik Schulz",
        contact: {
            name: "Daniel Arm",
            whatsapp: "0151 / 201 202 45",
            email: "danielarm@t-online.de",
        },
    },
];
---

<Layout
    title="Jugend VfL Primstal (G- bis E-Jugend) – VfL Primstal"
    description="Die Jugendmannschaften des VfL Primstal: G-Jugend (U7), F-Jugend (U9) und E-Jugend (U10/U11) mit Trainingszeiten, Trainern und Ansprechpartnern."
>
    <Header />

    <main class="team-page-main">
        <section class="page-hero">
            <div class="container">
                <a href="/vfl-primstal/teams/jugend" class="back-link">
                    &larr; Zurück zur Jugend-Übersicht
                </a>
                <p class="hero-eyebrow">G- bis E-Jugend (U7 – U11)</p>
                <h1 class="hero-title">Jugend VfL Primstal</h1>
                <p class="hero-subtitle">
                    Von den Bambinis (G-Jugend) über die F-Jugend bis zur E-Jugend werden unsere
                    Nachwuchskicker direkt vom VfL Primstal betreut. Neue Kinder zum Reinschnuppern
                    sind jederzeit herzlich willkommen!
                </p>

                <nav class="quick-nav" aria-label="Schnellnavigation Altersklassen">
                    {youthTeams.map((t) => (
                        <a href={`#${t.id}`} class="quick-nav-link">
                            <span class="quick-nav-arrow" aria-hidden="true">&darr;</span> {t.name}
                        </a>
                    ))}
                </nav>
            </div>
        </section>

        <section class="team-section">
            <div class="container">
                <div class="age-sections">
                    {youthTeams.map((t) => (
                        <section id={t.id} class="age-editorial-section">
                            <!-- Left Rail: Age Group + Trainer & Kontakt Ledger -->
                            <div class="age-rail">
                                <span class="age-kicker">{t.ageGroup}</span>
                                <h2 class="age-title">{t.name}</h2>

                                <dl class="meta-ledger">
                                    <div class="meta-row">
                                        <dt class="meta-label">Trainerteam</dt>
                                        <dd class="meta-value">{t.coaches}</dd>
                                    </div>
                                    <div class="meta-row">
                                        <dt class="meta-label">Koordination</dt>
                                        <dd class="meta-value">{t.contact.name}</dd>
                                    </div>
                                    <div class="meta-row">
                                        <dt class="meta-label">WhatsApp</dt>
                                        <dd class="meta-value meta-value--tabular">{t.contact.whatsapp}</dd>
                                    </div>
                                    <div class="meta-row">
                                        <dt class="meta-label">E-Mail</dt>
                                        <dd class="meta-value">
                                            <a href={`mailto:${t.contact.email}`} class="meta-email-link">
                                                {t.contact.email}
                                            </a>
                                        </dd>
                                    </div>
                                </dl>
                            </div>

                            <!-- Right Rail: 3 Informational Blocks -->
                            <div class="details-stack">
                                <div class="detail-block">
                                    <h3 class="detail-heading">Teams</h3>
                                    <p class="detail-text">{t.teamsText}</p>
                                </div>

                                <div class="detail-block">
                                    <h3 class="detail-heading">{t.matchInfoTitle}</h3>
                                    <p class="detail-text">{t.matchInfo}</p>
                                </div>

                                <div class="detail-block">
                                    <h3 class="detail-heading">Trainingsort &amp; Trainingszeiten</h3>
                                    <p class="detail-text">{t.training}</p>
                                </div>
                            </div>
                        </section>
                    ))}
                </div>

                <div class="switch-callout">
                    <div>
                        <span class="switch-label">Ältere Jahrgänge (U13 – U19)</span>
                        <h3 class="switch-title">Ab der D-Jugend: JFG Schaumberg-Prims</h3>
                        <p class="switch-text">
                            Unsere D-, C-, B- und A-Jugendmannschaften spielen im Rahmen der Jugendfördergemeinschaft
                            JFG Schaumberg-Prims.
                        </p>
                    </div>
                    <a href="/vfl-primstal/teams/jugend/jfg-schaumberg-prims" class="btn-outline">
                        Zur JFG Schaumberg-Prims &rarr;
                    </a>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    .team-page-main {
        padding-top: var(--header-height);
        min-height: 100vh;
    }

    .page-hero {
        background: var(--color-bg);
        padding: 4rem 0 2.5rem;
        border-bottom: 1px solid var(--color-border);
        position: relative;
        overflow: hidden;
    }

    .page-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at 30% 60%,
            rgba(200, 16, 46, 0.07) 0%,
            transparent 65%
        );
        pointer-events: none;
    }

    .page-hero .container {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .back-link {
        display: inline-block;
        color: var(--color-text-muted);
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        margin-bottom: 1.25rem;
        transition: color 0.2s ease;
    }

    .back-link:hover {
        color: var(--color-red);
    }

    .hero-title {
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        font-weight: 800;
        color: var(--color-text);
        line-height: 1.1;
        letter-spacing: -0.025em;
        margin-bottom: 1rem;
        text-wrap: balance;
    }

    .hero-subtitle {
        color: var(--color-text-muted);
        font-size: 1.05rem;
        max-width: 65ch;
        line-height: 1.7;
        margin-bottom: 2.25rem;
        text-wrap: pretty;
    }

    .quick-nav {
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--color-border);
    }

    .quick-nav-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--color-text);
        font-size: 0.88rem;
        font-weight: 700;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .quick-nav-arrow {
        color: var(--color-red);
    }

    .quick-nav-link:hover {
        color: var(--color-red);
    }

    .team-section {
        background: var(--color-bg-alt);
        padding: 1rem 0 6rem;
    }

    .age-sections {
        display: flex;
        flex-direction: column;
        margin-bottom: 3.5rem;
    }

    .age-editorial-section {
        scroll-margin-top: calc(var(--header-height) + 1.5rem);
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 4rem;
        padding: 4rem 0;
        border-bottom: 1px solid var(--color-border);
        align-items: start;
    }

    .age-rail {
        display: flex;
        flex-direction: column;
    }

    .age-kicker {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-red);
        margin-bottom: 0.35rem;
        font-variant-numeric: tabular-nums;
    }

    .age-title {
        font-size: clamp(1.5rem, 2.5vw, 1.85rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--color-text);
        margin: 0 0 1.75rem;
        line-height: 1.15;
    }

    .meta-ledger {
        border-top: 1px solid var(--color-border);
    }

    .meta-row {
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .meta-label {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-red);
    }

    .meta-value {
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--color-text);
        line-height: 1.45;
    }

    .meta-value--tabular {
        font-variant-numeric: tabular-nums;
    }

    .meta-email-link {
        color: var(--color-red);
        text-decoration: underline;
        text-underline-offset: 3px;
        transition: color 0.2s ease;
        overflow-wrap: anywhere;
    }

    .meta-email-link:hover {
        color: var(--color-red-light);
    }

    .details-stack {
        display: flex;
        flex-direction: column;
        border-top: 2px solid var(--color-border);
    }

    .detail-block {
        padding: 1.75rem 0;
        border-bottom: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .detail-block:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .detail-heading {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-red);
        margin: 0;
    }

    .detail-text {
        color: var(--color-text-muted);
        font-size: 1.02rem;
        line-height: 1.78;
        margin: 0;
        max-width: 65ch;
        text-wrap: pretty;
    }

    .switch-callout {
        border-top: 2px solid var(--color-text);
        padding-top: 3.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 2rem;
    }

    .switch-label {
        display: block;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-red);
        margin-bottom: 0.3rem;
    }

    .switch-title {
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--color-text);
        margin: 0 0 0.35rem;
    }

    .switch-text {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        margin: 0;
        max-width: 58ch;
        line-height: 1.65;
        text-wrap: pretty;
    }

    @media (max-width: 860px) {
        .age-editorial-section {
            grid-template-columns: 1fr;
            gap: 2rem;
            padding: 2.5rem 0;
        }
    }
</style>
