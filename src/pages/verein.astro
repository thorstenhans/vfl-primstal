---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config/site";

const keyFacts = [
    {
        icon: "🗓️",
        label: "Gründung",
        value: "1931",
        detail: "Über 90 Jahre Fußballtradition im Nordsaarland",
    },
    {
        icon: "👥",
        label: "Mitglieder",
        value: "ca. 475",
        detail: "Aktive Spieler, Jugend, Alte Herren & Förderer",
    },
    {
        icon: "⚫🔴",
        label: "Vereinsfarben",
        value: "Schwarz-Rot",
        detail: "Unsere Farben auf und neben dem Platz",
    },
    {
        icon: "🏟️",
        label: "Allerswaldstadion",
        value: "bis 3.500 Zuschauer",
        detail: "Moderne Kunstrasenanlage in Nonnweiler-Primstal",
    },
];

const clubPillars = [
    {
        title: "Aktive Mannschaften",
        text: "Der VfL Primstal ist seit vielen Jahren eine feste Größe im höherklassigen saarländischen Amateurfußball. Unsere 1. Mannschaft tritt in der Verbandsliga Nord-Ost an, während unsere 2. Mannschaft bereits seit 2013 durchgängig in der Landesliga Nord aktiv ist.",
    },
    {
        title: "Durchgängige Nachwuchsarbeit",
        text: "Von den kleinsten Kickern in der G-Jugend bis zur E-Jugend betreuen wir unsere Talente direkt im Verein. Ab der D- bis zur A-Jugend bündeln wir unsere Kräfte erfolgreich in der JFG Schaumberg-Prims, um jedem Jahrgang optimale Entwicklungsmöglichkeiten zu bieten.",
    },
    {
        title: "Alte Herren & Vereinsleben",
        text: "Fußball verbindet Generationen: Unsere Alte-Herren-Abteilung (AH) sowie zahlreiche Ehrenamtliche, Fans und Unterstützer machen den VfL Primstal zu einer lebendigen Gemeinschaft weit über die 90 Minuten auf dem Platz hinaus.",
    },
];

const subpages = [
    {
        title: "Unser Stadion",
        badge: "Allerswaldstadion",
        href: "/vfl-primstal/stadion",
        icon: "🏟️",
        description:
            "Unsere Kunstrasenanlage „Allerswaldstadion“ am Schwimmbad 10 in Primstal bietet Platz für bis zu 3.500 Zuschauer und ist seit 1959 das Herzstück unseres Vereinslebens.",
        cta: "Zum Stadion & Anfahrt",
    },
    {
        title: "Vereinschronik",
        badge: "Seit 1931",
        href: "/vfl-primstal/chronik",
        icon: "📜",
        description:
            "Von der Gründung im Jahr 1931 über historische Meisterschaften und Aufstiege bis in die Gegenwart – entdecke die Geschichte des VfL Primstal.",
        cta: "Chronik entdecken",
    },
    {
        title: "Der Vorstand",
        badge: "Vereinsführung",
        href: "/vfl-primstal/vorstand",
        icon: "🤝",
        description:
            "Lerne das Präsidium und die Vorstandsmitglieder kennen, die sich ehrenamtlich für die sportliche und organisatorische Weiterentwicklung unseres Vereins einsetzen.",
        cta: "Vorstand ansehen",
    },
];
---

<Layout
    title="Unser Verein – VfL Primstal"
    description="Der Verein für Leibesübungen Primstal e.V. im Porträt – gegründet 1931, ca. 475 Mitglieder, Vereinsfarben Schwarz-Rot, beheimatet im Allerswaldstadion."
>
    <Header />

    <main class="club-page-main">
        <!-- Hero -->
        <section class="page-hero">
            <div class="container">
                <span class="hero-badge">Seit 1931 &middot; Schwarz &amp; Rot</span>
                <h1 class="hero-title">{siteConfig.club.fullName}</h1>
                <p class="hero-subtitle">
                    Mit rund 475 Mitgliedern, einer modernen Kunstrasenanlage im Allerswaldstadion
                    und Mannschaften von den Bambinis bis zu den Alten Herren ist der VfL Primstal
                    seit 1931 die sportliche Heimat im Herzen des Nordsaarlandes.
                </p>
            </div>
        </section>

        <!-- Vorstellung & Eckdaten -->
        <section class="presentation-section">
            <div class="container">
                <div class="section-header">
                    <h2 class="subsection-title">Der VfL Primstal im Überblick</h2>
                    <p class="subsection-subtitle">
                        Tradition, sportlicher Ehrgeiz und gelebte Kameradschaft in Nonnweiler-Primstal.
                    </p>
                </div>

                <!-- 4 Key Facts aus der Vereinspräsentation -->
                <div class="facts-grid">
                    {keyFacts.map((fact) => (
                        <div class="fact-card">
                            <span class="fact-icon" aria-hidden="true">{fact.icon}</span>
                            <span class="fact-label">{fact.label}</span>
                            <strong class="fact-value">{fact.value}</strong>
                            <p class="fact-detail">{fact.detail}</p>
                        </div>
                    ))}
                </div>

                <!-- 3 Säulen des Vereins -->
                <div class="pillars-grid">
                    {clubPillars.map((pillar) => (
                        <article class="pillar-card">
                            <h3 class="pillar-title">{pillar.title}</h3>
                            <p class="pillar-text">{pillar.text}</p>
                        </article>
                    ))}
                </div>

                <div class="section-divider"></div>

                <!-- Kacheln zu den Unterseiten: Stadion, Chronik, Vorstand -->
                <div class="section-header">
                    <h2 class="subsection-title">Mehr über unseren Verein</h2>
                    <p class="subsection-subtitle">
                        Erfahre mehr über unsere Heimspielstätte, unsere Historie und die Menschen hinter dem VfL.
                    </p>
                </div>

                <div class="subpages-grid">
                    {subpages.map((page) => (
                        <article class="subpage-card">
                            <div class="subpage-top">
                                <span class="subpage-badge">{page.badge}</span>
                                <span class="subpage-icon" aria-hidden="true">{page.icon}</span>
                            </div>
                            <h3 class="subpage-title">
                                <a href={page.href} class="subpage-main-link">
                                    {page.title}
                                </a>
                            </h3>
                            <p class="subpage-desc">{page.description}</p>
                            <div class="subpage-footer">
                                <span class="subpage-cta" aria-hidden="true">
                                    {page.cta} &rarr;
                                </span>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    .club-page-main {
        padding-top: var(--header-height);
        min-height: 100vh;
    }

    .page-hero {
        background: var(--color-bg);
        padding: 5rem 0 4rem;
        border-bottom: 1px solid var(--color-border);
        position: relative;
        overflow: hidden;
    }

    .page-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at 30% 60%,
            rgba(200, 16, 46, 0.08) 0%,
            transparent 65%
        );
        pointer-events: none;
    }

    .page-hero .container {
        position: relative;
    }

    .hero-badge {
        display: inline-block;
        background: var(--color-red-glow);
        border: 1px solid var(--color-border-accent);
        color: var(--color-red);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        padding: 0.3rem 0.9rem;
        border-radius: 20px;
        margin-bottom: 1.25rem;
    }

    .hero-title {
        font-size: clamp(2rem, 4.5vw, 3.25rem);
        font-weight: 800;
        color: var(--color-text);
        line-height: 1.15;
        margin-bottom: 1rem;
        padding-left: 1rem;
        border-left: 4px solid var(--color-red);
    }

    .hero-subtitle {
        color: var(--color-text-muted);
        font-size: 1.05rem;
        max-width: 720px;
        line-height: 1.7;
        padding-left: 1.25rem;
    }

    .presentation-section {
        background: var(--color-bg-alt);
        padding: 4.5rem 0 6rem;
    }

    .section-header {
        margin-bottom: 2rem;
    }

    .subsection-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-text);
        line-height: 1.2;
        margin: 0 0 0.35rem;
        padding-left: 1rem;
        border-left: 4px solid var(--color-red);
    }

    .subsection-subtitle {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        line-height: 1.6;
        padding-left: 1.25rem;
        margin: 0;
    }

    /* Key Facts Grid */
    .facts-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .fact-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-top: 3px solid var(--color-red);
        border-radius: 12px;
        padding: 1.75rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .fact-icon {
        font-size: 1.5rem;
        margin-bottom: 0.25rem;
    }

    .fact-label {
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-red);
    }

    .fact-value {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--color-text);
        line-height: 1.2;
    }

    .fact-detail {
        font-size: 0.85rem;
        color: var(--color-text-muted);
        line-height: 1.5;
        margin: 0.2rem 0 0;
    }

    /* Club Pillars */
    .pillars-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .pillar-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-left: 4px solid var(--color-red);
        border-radius: 12px;
        padding: 1.75rem;
    }

    .pillar-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--color-text);
        margin: 0 0 0.65rem;
    }

    .pillar-text {
        font-size: 0.92rem;
        color: var(--color-text-muted);
        line-height: 1.7;
        margin: 0;
    }

    /* Divider */
    .section-divider {
        height: 1px;
        background: var(--color-border);
        margin: 4rem 0;
        position: relative;
    }

    .section-divider::after {
        content: "";
        position: absolute;
        left: 0;
        top: -1px;
        width: 64px;
        height: 3px;
        background: var(--color-red);
    }

    /* Subpages Cards Grid */
    .subpages-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.75rem;
    }

    .subpage-card {
        position: relative;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 14px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        transition:
            transform 0.2s ease,
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .subpage-card:hover {
        transform: translateY(-4px);
        border-color: var(--color-border-accent);
        box-shadow: 0 12px 32px rgba(200, 16, 46, 0.1);
    }

    .subpage-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .subpage-badge {
        display: inline-block;
        background: var(--color-red-glow);
        color: var(--color-red);
        border: 1px solid var(--color-border-accent);
        border-radius: 20px;
        padding: 0.22rem 0.8rem;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .subpage-icon {
        font-size: 1.5rem;
    }

    .subpage-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--color-text);
        margin: 0;
    }

    .subpage-main-link {
        color: inherit;
        text-decoration: none;
    }

    .subpage-main-link::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: 14px;
    }

    .subpage-desc {
        color: var(--color-text-muted);
        font-size: 0.92rem;
        line-height: 1.65;
        margin: 0;
        flex: 1;
    }

    .subpage-footer {
        margin-top: 0.5rem;
        padding-top: 0.9rem;
        border-top: 1px solid var(--color-border);
    }

    .subpage-cta {
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--color-red);
        transition: color 0.2s ease;
    }

    .subpage-card:hover .subpage-cta {
        color: var(--color-red-light);
        text-decoration: underline;
    }

    @media (max-width: 1024px) {
        .facts-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .pillars-grid,
        .subpages-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 560px) {
        .facts-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
