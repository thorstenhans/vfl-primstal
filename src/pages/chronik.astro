---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import milestones from "../data/chronik.json";
---
<Layout
  title="Chronik – VfL Primstal"
  description="Die Geschichte des VfL Primstal von 1931 bis heute. Meisterschaften, Jubiläen und unvergessliche Momente."
>
  <Header />
  <main>
    <section class="chronik-hero">
      <div class="container">
        <p class="hero-eyebrow">Seit 1931 &middot; Vereinschronik</p>
        <h1 class="hero-title">Unsere Geschichte</h1>
        <p class="hero-subtitle">
          Über 90 Jahre Leidenschaft, Zusammenhalt und Fußball im Herzen des Saarlandes.
          Eine Reise durch die Meilensteine des VfL Primstal.
        </p>
      </div>
    </section>

    <section class="timeline-section">
      <div class="container">
        <div class="timeline">
          {milestones.map((entry) => (
            <div class={"timeline-entry" + (entry.highlight ? " timeline-entry--highlight" : "")}>
              <div class="timeline-year">
                <span>{entry.year}</span>
              </div>
              <div class="timeline-connector">
                <div class="connector-dot"></div>
                <div class="connector-line"></div>
              </div>
              <div class="timeline-content">
                <p class="timeline-text">{entry.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .chronik-hero {
    padding: calc(var(--header-height) + 5rem) 0 4.5rem;
    background:
      radial-gradient(ellipse at 20% 50%, rgba(200, 16, 46, 0.08) 0%, transparent 60%),
      var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.08;
    margin-bottom: 1rem;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .hero-subtitle {
    color: var(--color-text-muted);
    font-size: 1.08rem;
    max-width: 60ch;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .timeline-section {
    padding: 5rem 0 6rem;
    background: var(--color-bg);
  }

  .timeline {
    position: relative;
    max-width: 860px;
  }

  .timeline-entry {
    display: grid;
    grid-template-columns: 96px 36px 1fr;
    gap: 0 1.5rem;
    align-items: start;
    min-height: 3rem;
  }

  .timeline-year {
    text-align: right;
    padding-top: 0.15rem;
    padding-bottom: 2rem;
  }

  .timeline-year span {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-muted);
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }

  .timeline-entry--highlight .timeline-year span {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-red);
    letter-spacing: -0.02em;
  }

  .timeline-connector {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: 100%;
  }

  .connector-dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    background: var(--color-border);
    border-radius: 50%;
    margin-top: 0.45rem;
    z-index: 1;
  }

  .timeline-entry--highlight .connector-dot {
    width: 12px;
    height: 12px;
    background: var(--color-red);
    box-shadow: 0 0 0 3px var(--color-bg);
    margin-top: 0.35rem;
  }

  .connector-line {
    flex: 1;
    width: 1px;
    background: var(--color-border);
    margin-top: 4px;
    min-height: 2rem;
  }

  .timeline-entry:last-child .connector-line {
    display: none;
  }

  .timeline-content {
    padding-bottom: 2rem;
    border-bottom: 1px solid transparent;
  }

  .timeline-text {
    color: var(--color-text-muted);
    font-size: 0.96rem;
    line-height: 1.7;
    padding-top: 0.1rem;
    max-width: 65ch;
    text-wrap: pretty;
  }

  .timeline-entry--highlight .timeline-text {
    color: var(--color-text);
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.65;
    padding-top: 0.05rem;
  }

  @media (max-width: 600px) {
    .timeline-entry {
      grid-template-columns: 1fr;
      gap: 0;
      padding-left: 1.35rem;
      border-left: 1px solid var(--color-border);
      position: relative;
    }

    .timeline-connector {
      display: none;
    }

    .timeline-year {
      text-align: left;
      padding-top: 0;
      padding-bottom: 0.25rem;
    }

    .timeline-content {
      padding-bottom: 1.75rem;
    }

    .timeline-entry::before {
      content: "";
      position: absolute;
      left: -4px;
      top: 0.45rem;
      width: 7px;
      height: 7px;
      background: var(--color-border);
      border-radius: 50%;
    }

    .timeline-entry--highlight::before {
      left: -5px;
      width: 9px;
      height: 9px;
      background: var(--color-red);
    }
  }
</style>
