---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import milestones from "../data/chronik.json";
---
<Layout
  title="Chronik – VfL Primstal"
  description="Die Geschichte des VfL Primstal von 1931 bis heute. Meisterschaften, Jubiläen und unvergessliche Momente."
>
  <Header />
  <main>
    <section class="chronik-hero">
      <div class="container">
        <span class="badge">Gegründet 1931</span>
        <h1 class="hero-title">Unsere Geschichte</h1>
        <p class="hero-subtitle">
          Über 90 Jahre Leidenschaft, Zusammenhalt und Fußball im Herzen des Saarlandes.
          Eine Reise durch die Meilensteine des VfL Primstal.
        </p>
      </div>
    </section>

    <section class="timeline-section">
      <div class="container">
        <div class="timeline">
          {milestones.map((entry) => (
            <div class={"timeline-entry" + (entry.highlight ? " timeline-entry--highlight" : "")}>
              <div class="timeline-year">
                <span>{entry.year}</span>
              </div>
              <div class="timeline-connector">
                <div class="connector-dot"></div>
                <div class="connector-line"></div>
              </div>
              <div class="timeline-content">
                {entry.highlight ? (
                  <div class="timeline-card">{entry.text}</div>
                ) : (
                  <p class="timeline-text">{entry.text}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .chronik-hero {
    padding: calc(var(--header-height) + 5rem) 0 5rem;
    background:
      radial-gradient(ellipse at 20% 50%, rgba(200, 16, 46, 0.12) 0%, transparent 60%),
      var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .badge {
    display: inline-block;
    background: var(--color-red-glow);
    color: var(--color-red);
    border: 1px solid var(--color-border-accent);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.1;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    max-width: 580px;
    line-height: 1.7;
  }

  .timeline-section {
    padding: 5rem 0 6rem;
    background: var(--color-bg);
  }

  .timeline {
    position: relative;
    max-width: 860px;
  }

  .timeline-entry {
    display: grid;
    grid-template-columns: 90px 36px 1fr;
    gap: 0 1.25rem;
    align-items: start;
    min-height: 3rem;
  }

  .timeline-year {
    text-align: right;
    padding-top: 0.2rem;
    padding-bottom: 1.75rem;
  }

  .timeline-year span {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-red);
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }

  .timeline-entry--highlight .timeline-year span {
    font-size: 1.2rem;
    font-weight: 800;
  }

  .timeline-connector {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: 100%;
  }

  .connector-dot {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    background: var(--color-red);
    border-radius: 50%;
    border: 2px solid var(--color-bg);
    box-shadow: 0 0 0 2px var(--color-red-dark);
    margin-top: 0.35rem;
    z-index: 1;
  }

  .timeline-entry--highlight .connector-dot {
    width: 14px;
    height: 14px;
    box-shadow: 0 0 0 2px var(--color-red), 0 0 12px rgba(200, 16, 46, 0.4);
    margin-top: 0.25rem;
  }

  .connector-line {
    flex: 1;
    width: 2px;
    background: var(--color-border);
    margin-top: 4px;
    min-height: 2rem;
  }

  .timeline-entry:last-child .connector-line {
    display: none;
  }

  .timeline-content {
    padding-bottom: 1.75rem;
  }

  .timeline-text {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.75;
    padding-top: 0.15rem;
  }

  .timeline-card {
    background: var(--color-surface);
    border-left: 3px solid var(--color-red);
    border-radius: 0 8px 8px 0;
    padding: 1rem 1.25rem;
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.75;
    box-shadow: var(--shadow-card);
    transition: background 0.2s ease;
  }

  .timeline-card:hover {
    background: var(--color-surface-hover);
  }

  @media (max-width: 600px) {
    .timeline-entry {
      grid-template-columns: 1fr;
      gap: 0;
      padding-left: 1.25rem;
      border-left: 2px solid var(--color-border);
      position: relative;
    }

    .timeline-entry--highlight {
      border-left-color: var(--color-red);
    }

    .timeline-connector {
      display: none;
    }

    .timeline-year {
      text-align: left;
      padding-top: 0;
      padding-bottom: 0.25rem;
    }

    .timeline-year span {
      font-size: 1rem;
    }

    .timeline-content {
      padding-bottom: 1.5rem;
    }

    .timeline-entry::before {
      content: "";
      position: absolute;
      left: -5px;
      top: 0.45rem;
      width: 8px;
      height: 8px;
      background: var(--color-red-dark);
      border-radius: 50%;
      border: 2px solid var(--color-bg);
    }

    .timeline-entry--highlight::before {
      background: var(--color-red);
      box-shadow: 0 0 8px rgba(200, 16, 46, 0.5);
    }
  }
</style>
