---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config/site";
import stadiumImage from "../images/allerswaldstadion.jpg";

const stadiumFacts = [
    {
        icon: "🏟️",
        label: "Fassungsvermögen",
        value: "bis 3.500 Zuschauer",
    },
    {
        icon: "🌱",
        label: "Spielfeld",
        value: "Moderne Kunstrasenanlage",
    },
    {
        icon: "🗓️",
        label: "Heimat seit",
        value: "1959",
    },
    {
        icon: "📍",
        label: "Standort",
        value: "Am Schwimmbad 10, Primstal",
    },
];
---

<Layout
    title="Allerswaldstadion – VfL Primstal"
    description="Das Allerswaldstadion in Nonnweiler-Primstal – die Kunstrasenanlage und Heimspielstätte des VfL Primstal e.V. mit Platz für bis zu 3.500 Zuschauer."
>
    <Header />

    <main class="stadion-page-main">
        <section class="page-hero">
            <div class="container">
                <a href="/vfl-primstal/verein" class="back-link">
                    &larr; Zurück zur Vereinsübersicht
                </a>
                <span class="hero-badge">Heimspielstätte</span>
                <h1 class="hero-title">{siteConfig.club.stadium.name}</h1>
                <p class="hero-subtitle">
                    Unser Zuhause seit 1959: Das idyllisch gelegene Allerswaldstadion in
                    Nonnweiler-Primstal verfügt über eine moderne Kunstrasenanlage und bietet
                    Platz für bis zu 3.500 Zuschauer.
                </p>
            </div>
        </section>

        <section class="stadion-section">
            <div class="container">
                <!-- Eckdaten -->
                <div class="facts-grid">
                    {stadiumFacts.map((fact) => (
                        <div class="fact-card">
                            <span class="fact-icon" aria-hidden="true">{fact.icon}</span>
                            <span class="fact-label">{fact.label}</span>
                            <strong class="fact-value">{fact.value}</strong>
                        </div>
                    ))}
                </div>

                <!-- Hauptbereich: Info & Luftaufnahme -->
                <div class="location-grid">
                    <div class="info-card">
                        <h2 class="stadium-name">{siteConfig.club.stadium.name}</h2>
                        <div class="red-divider"></div>
                        <p class="stadium-desc">
                            Ob spannende Ligaspiele unserer 1. und 2. Mannschaft, Jugendturniere
                            oder das wöchentliche Training unserer Mannschaften – im Allerswaldstadion
                            schlägt das schwarz-rote Herz des VfL Primstal. Unser angeschlossenes
                            Clubheim lädt an Spieltagen zum geselligen Beisammensein ein.
                        </p>

                        <div class="address-block">
                            <div class="address-row">
                                <span class="address-icon" aria-hidden="true">📍</span>
                                <span class="address-text">{siteConfig.club.address.street}</span>
                            </div>
                            <div class="address-row">
                                <span class="address-icon" aria-hidden="true">🏙️</span>
                                <span class="address-text">{siteConfig.club.address.city}</span>
                            </div>
                            <div class="address-row">
                                <span class="address-icon" aria-hidden="true">🗺️</span>
                                <span class="address-text">Saarland, Deutschland</span>
                            </div>
                        </div>

                        <a
                            href={siteConfig.club.stadium.mapsUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-primary map-btn"
                        >
                            In Google Maps öffnen &rarr;
                        </a>
                    </div>

                    <div class="stadium-photo-card">
                        <Image
                            src={stadiumImage}
                            alt="Luftaufnahme des Allerswaldstadions in Nonnweiler-Primstal"
                            class="stadium-photo"
                            width={1200}
                            height={675}
                        />
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    .stadion-page-main {
        padding-top: var(--header-height);
        min-height: 100vh;
    }

    .page-hero {
        background: var(--color-bg);
        padding: 4rem 0 3.5rem;
        border-bottom: 1px solid var(--color-border);
        position: relative;
        overflow: hidden;
    }

    .page-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at 30% 60%,
            rgba(200, 16, 46, 0.08) 0%,
            transparent 65%
        );
        pointer-events: none;
    }

    .page-hero .container {
        position: relative;
    }

    .back-link {
        display: inline-block;
        color: var(--color-text-muted);
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        margin-bottom: 1.25rem;
        transition: color 0.2s ease;
    }

    .back-link:hover {
        color: var(--color-red);
    }

    .hero-badge {
        display: block;
        width: fit-content;
        background: var(--color-red-glow);
        border: 1px solid var(--color-border-accent);
        color: var(--color-red);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        padding: 0.3rem 0.9rem;
        border-radius: 20px;
        margin-bottom: 1.25rem;
    }

    .hero-title {
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        font-weight: 800;
        color: var(--color-text);
        line-height: 1.1;
        margin-bottom: 1rem;
        padding-left: 1rem;
        border-left: 4px solid var(--color-red);
    }

    .hero-subtitle {
        color: var(--color-text-muted);
        font-size: 1.05rem;
        max-width: 680px;
        line-height: 1.7;
        padding-left: 1.25rem;
    }

    .stadion-section {
        background: var(--color-bg-alt);
        padding: 4rem 0 6rem;
    }

    .facts-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    .fact-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-top: 3px solid var(--color-red);
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .fact-icon {
        font-size: 1.4rem;
        margin-bottom: 0.15rem;
    }

    .fact-label {
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-red);
    }

    .fact-value {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--color-text);
    }

    .location-grid {
        display: grid;
        grid-template-columns: 1fr 1.15fr;
        gap: 2.5rem;
        align-items: stretch;
    }

    .info-card {
        background: var(--color-surface);
        border-radius: 12px;
        padding: 2.5rem;
        border: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1.35rem;
    }

    .stadium-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-text);
        margin: 0;
    }

    .red-divider {
        width: 40px;
        height: 2px;
        background: var(--color-red);
        margin-top: -0.6rem;
    }

    .stadium-desc {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        line-height: 1.7;
        margin: 0;
    }

    .address-block {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }

    .address-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .address-icon {
        font-size: 1rem;
        color: var(--color-red);
        min-width: 1.25rem;
    }

    .address-text {
        font-size: 0.95rem;
        color: var(--color-text-muted);
    }

    .map-btn {
        align-self: flex-start;
        display: inline-block;
        text-decoration: none;
        margin-top: 0.25rem;
    }

    .stadium-photo-card {
        aspect-ratio: 4 / 3;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--color-border);
        background-color: var(--color-surface);
    }

    .stadium-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    @media (max-width: 1024px) {
        .facts-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .location-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 560px) {
        .facts-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
