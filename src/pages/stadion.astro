---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config/site";
import stadiumImage from "../images/allerswaldstadion.jpg";

const stadiumFacts = [
    {
        label: "Fassungsvermögen",
        value: "bis 3.500 Zuschauer",
    },
    {
        label: "Spielfeld",
        value: "Moderne Kunstrasenanlage",
    },
    {
        label: "Heimat seit",
        value: "1959",
    },
    {
        label: "Standort",
        value: "Am Schwimmbad 10, Primstal",
    },
];
---

<Layout
    title="Allerswaldstadion – VfL Primstal"
    description="Das Allerswaldstadion in Nonnweiler-Primstal – die Kunstrasenanlage und Heimspielstätte des VfL Primstal e.V. mit Platz für bis zu 3.500 Zuschauer."
>
    <Header />

    <main class="stadion-page-main">
        <section class="page-hero">
            <div class="container">
                <a href="/vfl-primstal/verein" class="back-link">
                    &larr; Zurück zur Vereinsübersicht
                </a>
                <p class="hero-eyebrow">Heimspielstätte &middot; Seit 1959</p>
                <h1 class="hero-title">{siteConfig.club.stadium.name}</h1>
                <p class="hero-subtitle">
                    Unser Zuhause seit 1959: Das idyllisch gelegene Allerswaldstadion in
                    Nonnweiler-Primstal verfügt über eine moderne Kunstrasenanlage und bietet
                    Platz für bis zu 3.500 Zuschauer.
                </p>
            </div>
        </section>

        <section class="stadion-section">
            <div class="container">
                <!-- Eckdaten Architectural Bar -->
                <div class="facts-ledger">
                    {stadiumFacts.map((fact) => (
                        <div class="fact-cell">
                            <span class="fact-label">{fact.label}</span>
                            <strong class="fact-value">{fact.value}</strong>
                        </div>
                    ))}
                </div>

                <!-- Hauptbereich: Editorial Split & Luftaufnahme -->
                <div class="location-grid">
                    <div class="stadion-editorial">
                        <p class="section-eyebrow">Treffpunkt &amp; Spieltag</p>
                        <h2 class="subsection-title">{siteConfig.club.stadium.name}</h2>
                        <p class="stadium-desc">
                            Ob spannende Ligaspiele unserer 1. und 2. Mannschaft, Jugendturniere
                            oder das wöchentliche Training unserer Mannschaften – im Allerswaldstadion
                            schlägt das schwarz-rote Herz des VfL Primstal. Unser angeschlossenes
                            Clubheim lädt an Spieltagen zum geselligen Beisammensein ein.
                        </p>

                        <dl class="address-ledger">
                            <div class="address-row">
                                <dt class="address-label">Straße</dt>
                                <dd class="address-text">{siteConfig.club.address.street}</dd>
                            </div>
                            <div class="address-row">
                                <dt class="address-label">Ort</dt>
                                <dd class="address-text">{siteConfig.club.address.city}</dd>
                            </div>
                            <div class="address-row">
                                <dt class="address-label">Region</dt>
                                <dd class="address-text">Saarland, Deutschland</dd>
                            </div>
                        </dl>

                        <a
                            href={siteConfig.club.stadium.mapsUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-primary map-btn"
                        >
                            In Google Maps öffnen &rarr;
                        </a>
                    </div>

                    <div class="stadium-photo-frame">
                        <Image
                            src={stadiumImage}
                            alt="Luftaufnahme des Allerswaldstadions in Nonnweiler-Primstal"
                            class="stadium-photo"
                            width={1200}
                            height={675}
                        />
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    .stadion-page-main {
        padding-top: var(--header-height);
        min-height: 100vh;
    }

    .page-hero {
        background: var(--color-bg);
        padding: 4rem 0 3.5rem;
        border-bottom: 1px solid var(--color-border);
        position: relative;
        overflow: hidden;
    }

    .page-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at 30% 60%,
            rgba(200, 16, 46, 0.07) 0%,
            transparent 65%
        );
        pointer-events: none;
    }

    .page-hero .container {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .back-link {
        display: inline-block;
        color: var(--color-text-muted);
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        margin-bottom: 1.25rem;
        transition: color 0.2s ease;
    }

    .back-link:hover {
        color: var(--color-red);
    }

    .hero-title {
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        font-weight: 800;
        color: var(--color-text);
        line-height: 1.1;
        letter-spacing: -0.025em;
        margin-bottom: 1rem;
        text-wrap: balance;
    }

    .hero-subtitle {
        color: var(--color-text-muted);
        font-size: 1.05rem;
        max-width: 65ch;
        line-height: 1.7;
        text-wrap: pretty;
    }

    .stadion-section {
        background: var(--color-bg-alt);
        padding: 0 0 6rem;
    }

    .facts-ledger {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-bottom: 1px solid var(--color-border);
        margin-bottom: 5.5rem;
    }

    .fact-cell {
        padding: 2.5rem 1.75rem;
        border-right: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }

    .fact-cell:first-child {
        padding-left: 0;
    }

    .fact-cell:last-child {
        border-right: none;
        padding-right: 0;
    }

    .fact-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-red);
    }

    .fact-value {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--color-text);
        letter-spacing: -0.015em;
        font-variant-numeric: tabular-nums;
    }

    .location-grid {
        display: grid;
        grid-template-columns: 5fr 7fr;
        gap: 4.5rem;
        align-items: start;
    }

    .stadion-editorial {
        display: flex;
        flex-direction: column;
    }

    .stadium-desc {
        color: var(--color-text-muted);
        font-size: 1.02rem;
        line-height: 1.78;
        margin: 0.5rem 0 2.25rem;
        max-width: 58ch;
        text-wrap: pretty;
    }

    .address-ledger {
        border-top: 1px solid var(--color-border);
        margin-bottom: 2.25rem;
    }

    .address-row {
        display: grid;
        grid-template-columns: 110px 1fr;
        gap: 1.25rem;
        padding: 1.1rem 0;
        border-bottom: 1px solid var(--color-border);
        align-items: baseline;
    }

    .address-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-red);
    }

    .address-text {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--color-text);
    }

    .map-btn {
        align-self: flex-start;
        text-decoration: none;
    }

    .stadium-photo-frame {
        aspect-ratio: 16 / 10;
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid var(--color-border);
        background-color: var(--color-surface);
    }

    .stadium-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    @media (max-width: 1024px) {
        .facts-ledger {
            grid-template-columns: repeat(2, 1fr);
        }

        .fact-cell:nth-child(1),
        .fact-cell:nth-child(3) {
            padding-left: 0;
        }

        .fact-cell:nth-child(2) {
            border-right: none;
            padding-right: 0;
        }

        .fact-cell:nth-child(1),
        .fact-cell:nth-child(2) {
            border-bottom: 1px solid var(--color-border);
        }

        .location-grid {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }
    }

    @media (max-width: 560px) {
        .facts-ledger {
            grid-template-columns: 1fr;
        }

        .fact-cell {
            border-right: none;
            border-bottom: 1px solid var(--color-border);
            padding: 1.25rem 0;
        }

        .fact-cell:last-child {
            border-bottom: none;
        }
    }
</style>
