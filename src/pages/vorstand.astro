---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { members, praesidium } from "../config/vorstand";

const compareByLastnameAsc = (
    a: { lastname: string; firstname: string },
    b: { lastname: string; firstname: string }
) =>
    a.lastname.localeCompare(b.lastname, "de") ||
    a.firstname.localeCompare(b.firstname, "de");

const sortedPraesidium = [...praesidium].sort(compareByLastnameAsc);

const sortedMembers = [...members].sort((a, b) => {
    const pinnedDiff = Number(Boolean(b.pinned)) - Number(Boolean(a.pinned));
    if (pinnedDiff !== 0) return pinnedDiff;
    return compareByLastnameAsc(a, b);
});
---

<Layout
    title="Vorstand – VfL Primstal"
    description="Der Vorstand des VfL Primstal e.V. – die Menschen hinter dem Verein."
>
    <Header />

    <main class="vorstand-main">
        <section class="page-hero">
            <div class="container">
                <a href="/vfl-primstal/verein" class="back-link">
                    &larr; Zurück zur Vereinsübersicht
                </a>
                <p class="hero-eyebrow">Vereinsführung</p>
                <h1 class="hero-title">Der Vorstand</h1>
                <p class="hero-subtitle">
                    Diese engagierten Menschen führen den VfL Primstal e.V. und
                    sorgen dafür, dass unser Verein auf und neben dem Platz
                    reibungslos funktioniert.
                </p>
            </div>
        </section>

        <section class="board-section">
            <div class="container">
                <!-- ─── Präsidium (3 Executive Portrait Tiles) ─────────────── -->
                <div class="praesidium-section">
                    <div class="section-header">
                        <p class="section-eyebrow">Geschäftsführender Vorstand</p>
                        <h2 class="subsection-title">Das Präsidium</h2>
                        <p class="subsection-subtitle">
                            Die drei Vorsitzenden führen den Verein.
                        </p>
                    </div>

                    <div class="praesidium-grid">
                        {
                            sortedPraesidium.map((member) => (
                                <article class="member-card member-card--pinned">
                                    <div class="card-img-wrap">
                                        <img
                                            src={member.imageUrl}
                                            alt={`${member.firstname} ${member.lastname}`}
                                            class="card-img"
                                            width="120"
                                            height="120"
                                            loading="lazy"
                                        />
                                    </div>
                                    <div class="card-body">
                                        <span class="position-label">
                                            {member.position}
                                        </span>
                                        <h3 class="member-name">
                                            {member.firstname} {member.lastname}
                                        </h3>
                                        <a
                                            href={`mailto:${member.email}`}
                                            class="member-email"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                viewBox="0 0 24 24"
                                                fill="currentColor"
                                                width="13"
                                                height="13"
                                                aria-hidden="true"
                                            >
                                                <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
                                            </svg>
                                            {member.email}
                                        </a>
                                    </div>
                                </article>
                            ))
                        }
                    </div>
                </div>

                <!-- ─── Weitere Vorstandsmitglieder (Architectural Directory) ── -->
                <div class="members-section">
                    <div class="section-header">
                        <p class="section-eyebrow">Gesamtvorstand</p>
                        <h2 class="subsection-title">
                            Weitere Vorstandsmitglieder
                        </h2>
                        <p class="subsection-subtitle">
                            Ansprechpartner für Spielbetrieb, Finanzen, Jugend, Organisation und Vereinsleben.
                        </p>
                    </div>

                    <div class="board-grid">
                        {
                            sortedMembers.map((member) => (
                                <article
                                    class={
                                        "directory-row" +
                                        (member.pinned
                                            ? " directory-row--pinned"
                                            : "")
                                    }
                                >
                                    <div class="directory-avatar-wrap">
                                        <img
                                            src={member.imageUrl}
                                            alt={`${member.firstname} ${member.lastname}`}
                                            class="directory-avatar"
                                            width="144"
                                            height="144"
                                            loading="lazy"
                                        />
                                    </div>
                                    <div class="directory-info">
                                        <span class="position-label">
                                            {member.position}
                                        </span>
                                        <h3 class="directory-name">
                                            {member.firstname} {member.lastname}
                                        </h3>
                                        <a
                                            href={`mailto:${member.email}`}
                                            class="directory-email"
                                        >
                                            {member.email}
                                        </a>
                                    </div>
                                </article>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    .vorstand-main {
        padding-top: var(--header-height);
        min-height: 100vh;
    }

    .page-hero {
        background: var(--color-bg);
        padding: 4rem 0 3.5rem;
        border-bottom: 1px solid var(--color-border);
        position: relative;
        overflow: hidden;
    }

    .page-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at 30% 60%,
            rgba(200, 16, 46, 0.07) 0%,
            transparent 65%
        );
        pointer-events: none;
    }

    .page-hero .container {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .back-link {
        display: inline-block;
        color: var(--color-text-muted);
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        margin-bottom: 1.25rem;
        transition: color 0.2s ease;
    }

    .back-link:hover {
        color: var(--color-red);
    }

    .hero-title {
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        font-weight: 800;
        color: var(--color-text);
        line-height: 1.1;
        letter-spacing: -0.025em;
        margin-bottom: 1rem;
        text-wrap: balance;
    }

    .hero-subtitle {
        color: var(--color-text-muted);
        font-size: 1.05rem;
        max-width: 60ch;
        line-height: 1.7;
        text-wrap: pretty;
    }

    .board-section {
        background: var(--color-bg-alt);
        padding: 4.5rem 0 6rem;
    }

    .section-header {
        margin-bottom: 2.25rem;
    }

    /* ─── Tier 1: Präsidium Compact Executive Cards ─── */
    .praesidium-section {
        margin-bottom: 5.5rem;
    }

    .praesidium-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .member-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-top: 2px solid var(--color-red);
        border-radius: 6px;
        overflow: hidden;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 1.25rem;
        padding: 1.25rem;
        transition:
            transform 0.2s ease,
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .member-card:hover {
        transform: translateY(-2px);
        border-color: var(--color-red);
        box-shadow: var(--shadow-card-hover);
    }

    .card-img-wrap {
        width: 110px;
        height: 110px;
        min-width: 110px;
        border-radius: 6px;
        overflow: hidden;
        background: var(--color-surface-hover);
        border: 1px solid var(--color-border);
        position: relative;
    }

    .card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .card-body {
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        flex: 1;
        min-width: 0;
    }

    .position-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-red);
        line-height: 1.3;
    }

    .member-name {
        font-size: 1.08rem;
        font-weight: 800;
        color: var(--color-text);
        margin: 0;
        line-height: 1.25;
        text-wrap: wrap;
    }

    .member-email {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--color-text-muted);
        font-size: 0.8rem;
        text-decoration: none;
        margin-top: 0.35rem;
        transition: color 0.2s ease;
        overflow-wrap: anywhere;
    }

    .member-email:hover {
        color: var(--color-red);
    }

    /* ─── Tier 2: Extended Board Architectural Directory (Generous) ─── */
    .board-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 0 3rem;
        border-top: 2px solid var(--color-text);
    }

    .directory-row {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        padding: 1.35rem 0;
        border-bottom: 1px solid var(--color-border);
    }

    .directory-avatar-wrap {
        width: 96px;
        height: 96px;
        min-width: 96px;
        border-radius: 6px;
        overflow: hidden;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        position: relative;
    }

    .directory-row--pinned .directory-avatar-wrap {
        border-top: 2px solid var(--color-red);
    }

    .directory-avatar {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .directory-info {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
    }

    .directory-name {
        font-size: 1.08rem;
        font-weight: 800;
        color: var(--color-text);
        margin: 0;
        line-height: 1.25;
        text-wrap: wrap;
    }

    .directory-email {
        font-size: 0.82rem;
        color: var(--color-text-muted);
        text-decoration: none;
        transition: color 0.2s ease;
        overflow-wrap: anywhere;
        margin-top: 0.15rem;
    }

    .directory-email:hover {
        color: var(--color-red);
        text-decoration: underline;
    }

    @media (max-width: 1024px) {
        .praesidium-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .board-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }
    }
</style>
